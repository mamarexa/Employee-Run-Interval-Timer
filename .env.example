# MonCivique Run — Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.

# PostgreSQL password (choose a strong random password)
POSTGRES_PASSWORD=change_me_strong_password

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change_me_jwt_secret_48_chars_minimum

# Admin panel credentials
ADMIN_USERNAME=admin

# bcrypt hash of the admin password (cost factor 12)
# Generate with:
#   docker run --rm node:22-alpine node -e \
#     "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_PASSWORD_HASH=$2b$12$change_me_bcrypt_hash_here
